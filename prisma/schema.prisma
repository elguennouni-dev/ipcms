generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  role         String   @default("owner") // owner | support
  tokenVersion Int      @default(0)   // bump to sign out every device
  totpSecret   String   @default("")
  totpEnabled  Boolean  @default(false)
  lastTotpStep Int      @default(0)   // blocks re-use of the same 2FA code
  createdAt    DateTime @default(now())
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  key       String   // "ip:1.2.3.4" or "email:x@y.z"
  createdAt DateTime @default(now())
  @@index([key, createdAt])
}

model Plan {
  id        Int      @id @default(autoincrement())
  slug      String   @unique // 1m, 3m, 6m, 12m
  name      String
  months    Int
  price     Decimal  @db.Decimal(8, 2)
  badge     String   @default("")
  features  String   @db.Text // one feature per line
  visible   Boolean  @default(true)
  sort      Int      @default(0)
}

model Order {
  id        Int      @id @default(autoincrement())
  name      String
  whatsapp  String
  email     String   @default("")
  planSlug  String   // trial | 1m | 3m | ...
  planName  String
  source    String   @default("form") // form | whatsapp
  status    String   @default("New") // New | Contacted | Active | Done
  note      String   @default("") @db.Text
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model Section {
  id      Int     @id @default(autoincrement())
  key     String  @unique
  name    String
  descr   String  @default("")
  visible Boolean @default(true)
  sort    Int     @default(0)
}

model Setting {
  key   String @id
  value String @db.Text
}

model FaqItem {
  id       Int     @id @default(autoincrement())
  question String
  answer   String  @db.Text
  visible  Boolean @default(true)
  sort     Int     @default(0)
}

model Review {
  id      Int     @id @default(autoincrement())
  author  String
  text    String  @db.Text
  rating  Int     @default(5)
  visible Boolean @default(true)
  sort    Int     @default(0)
}

model Media {
  id        Int      @id @default(autoincrement())
  slot      String   // hero, sport-banner, device, logo, og, channel-1.., poster-1..
  label     String
  file      String   @default("") // stored filename (webp)
  alt       String   @default("")
  width     Int      @default(0)
  height    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([slot])
}

model LegalPage {
  id        Int      @id @default(autoincrement())
  slug      String   @unique // terms, privacy, refunds, dmca, cookies, contact
  title     String
  body      String   @db.Text // simple markdown-like text
  updatedAt DateTime @updatedAt
}

model DmcaNotice {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  work      String   @db.Text
  location  String   @db.Text
  signature String
  status    String   @default("Open") // Open | Reviewing | Resolved
  createdAt DateTime @default(now())
}

model Post {
  id             Int       @id @default(autoincrement())
  type           String    // blog | guide
  slug           String
  title          String
  excerpt        String    @default("") @db.Text
  body           String    @db.Text // markdown-like
  coverFile      String    @default("")
  coverAlt       String    @default("")
  category       String    @default("")
  tags           String    @default("") // comma separated
  author         String    @default("")
  status         String    @default("draft") // draft | published
  publishedAt    DateTime?
  faq            String    @default("") @db.Text // blocks:  Q: ...\nA: ...
  seoTitle       String    @default("")
  seoDescription String    @default("")
  focusKeyword   String    @default("")
  canonical      String    @default("")
  noindex        Boolean   @default(false)
  seoScore       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([type, slug])
  @@index([type, status, publishedAt])
}

model Redirect {
  id        Int      @id @default(autoincrement())
  fromPath  String   @unique
  toPath    String
  code      Int      @default(301)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}

model NotFoundLog {
  id     Int      @id @default(autoincrement())
  path   String   @unique
  hits   Int      @default(1)
  lastAt DateTime @default(now())
}
