# PostgreSQL
DATABASE_URL="postgresql://ipcms:YOUR_DB_PASSWORD@127.0.0.1:5432/ipcms?schema=public"

# Public site URL (used for sitemap, canonical, Open Graph)
SITE_URL="https://yourdomain.co.uk"

# Random 32+ char secret for admin sessions (openssl rand -hex 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account (created by `npm run db:seed`)
ADMIN_EMAIL="admin@yourdomain.co.uk"
ADMIN_PASSWORD="change-this-password"

# Where uploaded images are stored (keep OUTSIDE the git folder so deploys never delete them)
UPLOAD_DIR="/www/wwwroot/ipcms-uploads"

PORT=3000
